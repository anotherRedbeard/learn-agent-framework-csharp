{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Pin the server to http://localhost:5000 so Module 08's A2A client can
  // reach it at a stable URL. Without this, ASP.NET Core picks a random port.
  "Urls": "http://localhost:5000"

  // Add AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_DEPLOYMENT_NAME via:
  //   dotnet user-secrets set "AZURE_OPENAI_ENDPOINT" "https://..."
  //   dotnet user-secrets set "AZURE_OPENAI_DEPLOYMENT_NAME" "gpt-4o-mini"
  //
  // Never add credentials here — this file is committed to source control.
}
