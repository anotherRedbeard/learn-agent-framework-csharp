<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FoundryHosted</RootNamespace>
    <AssemblyName>FoundryHosted</AssemblyName>
    <!-- Microsoft.Agents.AI.Foundry.Hosting is currently preview and uses experimental APIs -->
    <NoWarn>$(NoWarn);OPENAI001;AAIP001</NoWarn>
  </PropertyGroup>

  <!-- Exclude scaffold file so it doesn't conflict with Program.cs -->
  <ItemGroup>
    <Compile Remove="*.scaffold.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Projects" Version="*-*" />
    <PackageReference Include="Azure.Identity" Version="*" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="*-*" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="*-*" />
  </ItemGroup>
</Project>
