# Copy to .env (gitignored) and fill in. For `dotnet run`, just `set -a; . ./.env`
# (or export the values) — Program.cs reads them directly from the environment.

# Use the BARE ACCOUNT host (no /api/projects/<project>). The agent's Responses
# client is served at the account level (/openai/v1/responses); including the
# /api/projects/<project> path returns 404 "Project not found".
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
AGENT_NAME=trip-planner
ASPNETCORE_URLS=http://+:8088
ASPNETCORE_ENVIRONMENT=Development
# Auth: Program.cs uses DefaultAzureCredential, so just `az login` (matching the
# canonical hello-world sample). No bearer token needed for local `dotnet run`.
