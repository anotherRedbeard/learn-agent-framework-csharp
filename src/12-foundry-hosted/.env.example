# Copy to .env (gitignored) and fill in. Used by `docker run --env-file .env`
# for local container debugging. For `dotnet run`, prefer dotnet user-secrets.

AZURE_OPENAI_ENDPOINT=https://<your-account>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AGENT_NAME=trip-planner
ASPNETCORE_URLS=http://+:8088
ASPNETCORE_ENVIRONMENT=Development
