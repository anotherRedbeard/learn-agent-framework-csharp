# Copy to .env (gitignored) and fill in. Used by `docker run --env-file .env`
# for local container debugging. For `dotnet run`, just export the values into
# your shell — Program.cs reads them directly from the environment.

AZURE_OPENAI_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AGENT_NAME=trip-planner
ASPNETCORE_URLS=http://+:8088
ASPNETCORE_ENVIRONMENT=Development
# AZURE_BEARER_TOKEN is *not* set here — it's a short-lived token, so pass it
# at run time via `docker run -e AZURE_BEARER_TOKEN=...` (see README Step 3).
