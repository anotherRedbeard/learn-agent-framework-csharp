<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude scaffold file so it doesn't conflict with Program.cs -->
  <ItemGroup>
    <Compile Remove="*.scaffold.cs" />
  </ItemGroup>

  <!-- The A2A package provides a typed client (A2AHttpJsonClient, A2ACardResolver)
       that handles the protocol wire format for us. A2A is just JSON over HTTP, so
       any language can call it — but using the official client keeps us in sync with
       the protocol as it evolves. -->
  <ItemGroup>
    <PackageReference Include="A2A" Version="*-*" />
  </ItemGroup>
</Project>
